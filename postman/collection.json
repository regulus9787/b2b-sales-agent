    {
      "name": "Reply",
      "item": [
        {
          "name": "Analyze Reply (Simulate)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('意图分类结果合法', () => {",
                  "  pm.expect(['interested', 'needs_info', 'rejected', 'neutral']).to.include(body.data.classification.intent);",
                  "  pm.expect(body.data.classification.confidence).to.be.within(0, 1);",
                  "});",
                  "pm.test('记录模型与 token', () => {",
                  "  pm.expect(body.data.model).to.be.a('string').and.not.empty;",
                  "  pm.expect(body.data.prompt_tokens).to.be.at.least(0);",
                  "});",
                  "console.log('意图:', body.data.classification.intent, '| 置信度:', body.data.classification.confidence, '| 状态:', body.data.from_status, '->', body.data.to_status);",
                  "console.log('建议动作:', body.data.classification.suggested_action);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"simulate\": true,\n  \"intent\": \"interested\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/reply/analyze/{{customerId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "reply", "analyze", "{{customerId}}"]
            },
            "description": "生成模拟客户回复并做意图分类，自动推进状态（replied → 意图状态）。"
          }
        },
        {
          "name": "Analyze Reply (Real Text)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('simulated = false', () => pm.expect(body.data.simulated).to.be.false);",
                  "pm.test('意图为 interested', () => pm.expect(body.data.classification.intent).to.eql('interested'));",
