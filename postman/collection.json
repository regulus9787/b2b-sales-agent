{
  "info": {
    "_postman_id": "b2b5a1e0-7c4d-4a6f-9f2b-1d8e5c3a9f10",
    "name": "B2B Sales Agent API",
    "description": "端到端 B2B 销售 Agent 接口集合。\n\n覆盖：健康检查 → 客户列表/详情 → 线索导入 → 生成开发信 → 回复分类 → Agent 工作流 → 执行详情 → 看板统计。\n\n运行前请先启动后端：npm run dev（默认 http://localhost:3000）。\nLLM_API_KEY 为空时自动进入 Mock 模式，无需任何密钥即可全部跑通。\n\n建议执行顺序：\n1) Health / Health Check\n2) Customers / List Customers（将首个客户 id 写入集合变量 customerId）\n3) Leads / Import Leads\n4) Email / Generate Email\n5) Reply / Analyze Reply (Simulate)\n6) Agent / Run Full Cycle\n7) Agent / Get Run Detail\n8) Dashboard / Get Stats",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string",
      "description": "后端地址"
    },
    {
      "key": "customerId",
      "value": "1",
      "type": "string",
      "description": "目标客户 ID（List Customers 会自动写入）"
    },
    {
      "key": "runId",
      "value": "",
      "type": "string",
      "description": "Agent 执行 ID（Run Full Cycle 会自动写入）"
    },
    {
      "key": "status",
      "value": "new",
      "type": "string",
      "description": "客户状态过滤条件"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// 统一注入请求 ID，便于与服务端日志/events 表对齐",
          "if (!pm.request.headers.has('x-request-id')) {",
          "  const rid = 'pm-' + Date.now() + '-' + Math.random().toString(16).slice(2, 10);",
          "  pm.request.headers.add({ key: 'x-request-id', value: rid });",
          "  pm.collectionVariables.set('lastRequestId', rid);",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('success = true', () => pm.expect(body.success).to.be.true);",
                  "pm.test('meta.request_id 存在', () => pm.expect(body.meta.request_id).to.be.a('string').and.not.empty);",
                  "pm.test('数据库正常', () => pm.expect(body.data.database).to.eql('ok'));",
                  "pm.test('注册了 5 个 Agent 工具', () => pm.expect(body.data.agent_tools).to.have.lengthOf(5));",
                  "console.log('LLM 模式:', body.data.llm.mode, '| schema 版本:', body.data.schema_version);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
