# ============================================================
# B2B Sales Agent —— 环境变量样例
# 复制为 .env 后按需修改：cp .env.example .env
# LLM_API_KEY 留空 => 自动进入 Mock 模式（零密钥可跑通全流程）
# ============================================================

# ---------- 服务 ----------
PORT=3000
NODE_ENV=development

# ---------- LLM 网关 ----------
# 留空 => Mock 模式（确定性邮件 + 关键词意图分类，保证可演示）
LLM_API_KEY=
# 重要：deepseek-chat / deepseek-reasoner 已于 2026-07-24 停用，不要再填这两个名字。
# DeepSeek（当前在售）: https://api.deepseek.com      deepseek-flash（或 deepseek-v4-pro）
# OpenAI:               https://api.openai.com/v1     gpt-4o-mini
# 豆包/方舟:            https://ark.cn-beijing.volces.com/api/v3   doubao-pro-32k
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_TIMEOUT_MS=60000
LLM_MAX_RETRIES=3
LLM_PROVIDER=deepseek
# 思考模式（DeepSeek 默认开启，本项目默认关闭以省 token 并保证 JSON 稳定）：
#   disabled | enabled | minimal | low | high | max
LLM_THINKING=disabled

# ---------- 数据库 ----------
DATABASE_PATH=./sales-agent.db

# ---------- 日志 ----------
LOG_LEVEL=info

# ---------- 前端 ----------
FRONTEND_PORT=5173
VITE_API_BASE_URL=
